<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd"
    version="5"
    map-background="#F2E7CF"
    map-background-outside="#DED1B6">

    <!-- Darbak Maps: car-screen first, desert-first, low visual noise. -->

    <!-- Water and seasonal drainage -->
    <rule e="way" k="natural|landuse" v="water|reservoir|basin">
        <area fill="#BFD8DF" stroke="#7FA7B3" stroke-width="0.35" />
        <rule e="way" k="*" v="*" zoom-min="13">
            <caption k="name" font-size="13" font-style="bold" fill="#315D68" stroke="#FFF9EE" stroke-width="2.0" />
        </rule>
    </rule>

    <rule e="way" k="waterway" v="river|stream|canal|drain|ditch|wadi">
        <line stroke="#6EABB9" stroke-width="1.2" />
        <rule e="way" k="intermittent" v="yes|true">
            <line stroke="#6EABB9" stroke-width="1.25" stroke-dasharray="6,5" />
        </rule>
        <rule e="way" k="*" v="*" zoom-min="12">
            <pathText k="name" font-size="12" font-style="bold" fill="#315D68" stroke="#FFF9EE" stroke-width="2.0" />
        </rule>
    </rule>

    <!-- Desert landforms -->
    <rule e="way" k="natural" v="sand|dune">
        <area fill="#E9D3A8" stroke="#D5BA84" stroke-width="0.25" />
    </rule>
    <rule e="way" k="natural" v="bare_rock|rock">
        <area fill="#D8C7AA" stroke="#A99573" stroke-width="0.35" />
    </rule>
    <rule e="way" k="natural" v="scrub|grassland|heath">
        <area fill="#E4E1BE" stroke="#B7B78C" stroke-width="0.2" />
    </rule>
    <rule e="way" k="natural" v="wetland|salt_pond">
        <area fill="#DED9C6" stroke="#9B957D" stroke-width="0.45" />
        <rule e="way" k="*" v="*" zoom-min="11">
            <caption k="name" font-size="12" fill="#5D584C" stroke="#FFF9EE" stroke-width="2.0" />
        </rule>
    </rule>
    <rule e="way" k="natural" v="valley">
        <area fill="#E7DCC4" stroke="#A88C63" stroke-width="0.65" />
        <rule e="way" k="*" v="*" zoom-min="11">
            <caption k="name" font-size="12" font-style="bold" fill="#70542F" stroke="#FFF9EE" stroke-width="2.0" />
        </rule>
    </rule>

    <!-- Protected areas: visible but quiet -->
    <rule e="way" k="boundary" v="protected_area|national_park">
        <line stroke="#57785A" stroke-width="1.3" stroke-dasharray="8,4" />
        <rule e="way" k="*" v="*" zoom-min="10">
            <pathText k="name" font-size="12" font-style="bold" fill="#426044" stroke="#FFF9EE" stroke-width="2.0" />
        </rule>
    </rule>

    <!-- Urban footprint kept subtle; Darbak is desert-first -->
    <rule e="way" k="landuse" v="residential|commercial|retail|industrial">
        <area fill="#E7E2D8" stroke="#CDC6B8" stroke-width="0.2" />
    </rule>
    <rule e="way" k="building" v="*" zoom-min="16">
        <area fill="#D9D3C8" stroke="#AEA79B" stroke-width="0.25" />
    </rule>

    <!-- Roads: strong hierarchy for quick reading while driving -->
    <rule e="way" k="highway" v="motorway|trunk">
        <line stroke="#5A5145" stroke-width="5.4" />
        <line stroke="#F3EEE3" stroke-width="4.2" />
        <rule e="way" k="*" v="*" zoom-min="10">
            <pathText k="name" font-size="13" font-style="bold" fill="#302B25" stroke="#FFF9EE" stroke-width="2.2" />
        </rule>
    </rule>
    <rule e="way" k="highway" v="primary|primary_link">
        <line stroke="#6B6257" stroke-width="4.5" />
        <line stroke="#FAF7EF" stroke-width="3.4" />
        <rule e="way" k="*" v="*" zoom-min="11">
            <pathText k="name" font-size="13" font-style="bold" fill="#302B25" stroke="#FFF9EE" stroke-width="2.2" />
        </rule>
    </rule>
    <rule e="way" k="highway" v="secondary|secondary_link|tertiary|tertiary_link">
        <line stroke="#7A7268" stroke-width="3.2" />
        <line stroke="#FBF8F0" stroke-width="2.3" />
        <rule e="way" k="*" v="*" zoom-min="12">
            <pathText k="name" font-size="12" fill="#37322C" stroke="#FFF9EE" stroke-width="2.0" />
        </rule>
    </rule>
    <rule e="way" k="highway" v="unclassified|residential|service|living_street|road">
        <line stroke="#8A8277" stroke-width="2.0" />
        <line stroke="#FBF8F0" stroke-width="1.3" />
        <rule e="way" k="*" v="*" zoom-min="14">
            <pathText k="name" font-size="11" fill="#4A443C" stroke="#FFF9EE" stroke-width="1.8" />
        </rule>
    </rule>

    <!-- Off-road network: the core Darbak layer -->
    <rule e="way" k="highway" v="track">
        <rule e="way" k="tracktype" v="grade1">
            <line stroke="#9B6C2F" stroke-width="2.5" />
        </rule>
        <rule e="way" k="tracktype" v="grade2">
            <line stroke="#A97938" stroke-width="2.4" stroke-dasharray="14,4" />
        </rule>
        <rule e="way" k="tracktype" v="grade3">
            <line stroke="#A97938" stroke-width="2.2" stroke-dasharray="10,6" />
        </rule>
        <rule e="way" k="tracktype" v="grade4|grade5">
            <line stroke="#9F7D4E" stroke-width="2.0" stroke-dasharray="5,6" />
        </rule>
        <rule e="way" k="tracktype" v="~">
            <line stroke="#A97938" stroke-width="2.1" stroke-dasharray="11,5" />
        </rule>
        <rule e="way" k="*" v="*" zoom-min="12">
            <pathText k="name" font-size="12" font-style="bold" fill="#6B471D" stroke="#FFF9EE" stroke-width="2.0" />
        </rule>
    </rule>
    <rule e="way" k="highway" v="path|bridleway">
        <line stroke="#977B58" stroke-width="1.5" stroke-dasharray="4,5" />
        <rule e="way" k="*" v="*" zoom-min="14">
            <pathText k="name" font-size="11" fill="#674F33" stroke="#FFF9EE" stroke-width="1.8" />
        </rule>
    </rule>

    <!-- Settlements and desert localities -->
    <rule e="node" k="place" v="city">
        <circle radius="4.0" fill="#263B34" stroke="#FFF9EE" stroke-width="1.2" />
        <caption k="name" font-size="16" font-style="bold" fill="#263B34" stroke="#FFF9EE" stroke-width="2.5" />
    </rule>
    <rule e="node" k="place" v="town">
        <circle radius="3.4" fill="#324A40" stroke="#FFF9EE" stroke-width="1.1" />
        <caption k="name" font-size="14" font-style="bold" fill="#263B34" stroke="#FFF9EE" stroke-width="2.2" />
    </rule>
    <rule e="node" k="place" v="village|hamlet" zoom-min="9">
        <circle radius="2.4" fill="#46594E" stroke="#FFF9EE" stroke-width="0.9" />
        <caption k="name" font-size="12" font-style="bold" fill="#34443B" stroke="#FFF9EE" stroke-width="2.0" />
    </rule>
    <rule e="node" k="place" v="locality|isolated_dwelling" zoom-min="11">
        <circle radius="2.0" fill="#8B692F" stroke="#FFF9EE" stroke-width="0.8" />
        <caption k="name" font-size="12" font-style="bold" fill="#674B1E" stroke="#FFF9EE" stroke-width="2.0" />
    </rule>

    <!-- Peaks and desert reference points -->
    <rule e="node" k="natural" v="peak|hill" zoom-min="10">
        <circle radius="2.4" fill="#765F47" stroke="#FFF9EE" stroke-width="0.8" />
        <caption k="name" font-size="12" font-style="bold" fill="#594735" stroke="#FFF9EE" stroke-width="2.0" />
    </rule>
    <rule e="node" k="natural" v="spring" zoom-min="12">
        <circle radius="2.8" fill="#5C9EAA" stroke="#FFF9EE" stroke-width="0.9" />
        <caption k="name" font-size="12" fill="#315D68" stroke="#FFF9EE" stroke-width="2.0" />
    </rule>
    <rule e="node" k="man_made" v="water_well" zoom-min="12">
        <circle radius="2.8" fill="#5C9EAA" stroke="#FFF9EE" stroke-width="0.9" />
        <caption k="name" font-size="12" fill="#315D68" stroke="#FFF9EE" stroke-width="2.0" />
    </rule>
    <rule e="node" k="amenity" v="drinking_water" zoom-min="12">
        <circle radius="2.7" fill="#67AAB6" stroke="#FFF9EE" stroke-width="0.9" />
        <caption k="name" font-size="11" fill="#315D68" stroke="#FFF9EE" stroke-width="1.8" />
    </rule>

    <!-- Useful POIs kept to driving essentials -->
    <rule e="node" k="amenity" v="fuel" zoom-min="11">
        <circle radius="3.1" fill="#C69A3A" stroke="#5A4723" stroke-width="0.9" />
        <caption k="name" font-size="12" font-style="bold" fill="#5A4723" stroke="#FFF9EE" stroke-width="2.0" />
    </rule>
    <rule e="node" k="tourism" v="camp_site|picnic_site|viewpoint" zoom-min="13">
        <circle radius="2.7" fill="#607B5B" stroke="#FFF9EE" stroke-width="0.9" />
        <caption k="name" font-size="11" fill="#42533E" stroke="#FFF9EE" stroke-width="2.0" />
    </rule>

</rendertheme>
